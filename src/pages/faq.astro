---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroHalaman from '../components/HeroHalaman.astro';
import BantuanJadwal from '../components/BantuanJadwal.astro';

// Item FAQ — item pertama terbuka secara default (sesuai desain)
const daftarFaq = [
  {
    pertanyaan: 'Apa perbedaan dari KESC dan KEYSI?',
    jawaban: [
      '<strong>King Expert Science Competition (KESC)</strong>  merupakan kompetisi ujian sains nasional yang terdiri dari berbagai macam cabang mata pelajaran untuk siswa SD, SMP, hingga SMA/sederajat.',
      'Sedangkan untuk <strong>King Expert Young Science Ideation (KEYSI)</strong> merupakan  kompetisi gagasan ilmiah kreatif untuk mengasah problem solving dan logis dengan menuangkan gagasan/ide inovatif dan aplikatif  yang dituangkan dalam bentuk esai. KEYSI terbuka untuk siswa/i SMP, SMA, hingga Mahasiswa, diikuti secara individu maupun tim (maksimal 3 orang).',
    ],
  },
  {
  pertanyaan: 'Kapan pendaftaran KESC & KEYSI 2027 dibuka?',
  jawaban: [
    'Pendaftaran KESC dibuka 6 November 2026 - 12 Januari 2027. Untuk KEYSI (Gagasan Kreatif), pendaftaran dan pengumpulan karya dibuka 6 November 2026 – 20 Januari 2027. Kamu bisa lihat Jadwal lengkapnya di sini <a href="/jadwal" class="font-semibold text-[#004AAD] hover:underline">Jadwal KESC & KEYSI</a>',
  ],
 },
  {
    pertanyaan: 'Apakah ikut lomba KESC dan KEYSI berbayar?',
    jawaban: [
      'Ya, pendaftaran KESC dan KEYSI 2027 berbayar. Biaya terbagi menjadi dua periode :',
        '<strong class="font-semibold text-[#475569]">Periode Early Bird (6 November - 15 Desember 2026)</strong>',

         '<ul class="list-disc pl-6 space-y-1 text-[#475569]"><li>Biaya pendaftaran KESC sebesar <strong class="font-bold text-[#475569]">Rp 95.000/peserta.</strong></li><li>Biaya pendaftaran KEYSI sebesar <strong class="font-bold text-[#475569]">Rp 118.750/peserta</strong> atau tim (maksimal 3 orang).</li></ul>',

        '<strong class="font-semibold text-[#475569]">Periode Pendaftaran Regular (Mulai 16 Desember 2026)</strong>',

         '<ul class="list-disc pl-6 space-y-1 text-[#475569]"><li>Biaya pendaftaran KESC sebesar <strong class="font-bold text-[#475569]">Rp 100.000/peserta. Pendaftaran ditutup 12 Januari 2027.</strong></li><li>Biaya pendaftaran KEYSI sebesar <strong class="font-bold text-[#475569]">Rp 125.000/peserta</strong> atau tim (maksimal 3 orang). <strong class="font-bold text-[#475569]">Pendaftaran ditutup 18 Januari 2027.</strong></li></ul>',
    ],
  },
  {
    pertanyaan: 'Boleh ikut KESC dan KEYSI sekaligus?',
    jawaban: [
      'Boleh! <strong class="font-bold text-[#475569]">KESC dan KEYSI merupakan dua cabang terpisah</strong> dengan pendaftaran dan biaya masing-masing. Jadi, kamu bisa ikut salah satu atau keduanya sekaligus.',
      'Kamu bisa tanya Admin King Expert melalui <a href="https://wa.me/6285183213414" target="_blank" rel="noopener noreferrer" class="font-semibold text-[#004AAD] hover:underline">WhatsApp</a> untuk penjelasan lebih lanjut.',
    ],
  },
  {
    pertanyaan: 'Jika ada kendala, saya harus menghubungi siapa?',
    jawaban: [
      'Jika terdapat kendala, silakan hubungi Admin King Expert/KESC berikut:',

    '<strong class="block mb-2 text-[#475569]">Admin WhatsApp:</strong><a href="https://wa.me/6285183213414" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-lg bg-[#E9F9EF] px-4 py-2 font-semibold text-[#16A34A] transition-colors hover:bg-[#D5F5DF]"><svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="size-5 shrink-0"><path d="M20.52 3.48A11.87 11.87 0 0 0 12.05 0C5.5 0 .16 5.33.16 11.89c0 2.1.55 4.14 1.59 5.95L.06 24l6.31-1.65a11.88 11.88 0 0 0 5.68 1.45h.01c6.55 0 11.89-5.34 11.89-11.9a11.83 11.83 0 0 0-3.43-8.42ZM12.05 21.8a9.9 9.9 0 0 1-5.04-1.38l-.36-.21-3.74.98.99-3.65-.24-.37a9.86 9.86 0 0 1-1.51-5.28c0-5.46 4.44-9.89 9.9-9.89a9.84 9.84 0 0 1 7 2.9 9.84 9.84 0 0 1 2.89 7c0 5.45-4.44 9.9-9.89 9.9Zm5.43-7.4c-.3-.15-1.76-.87-2.03-.97-.27-.1-.47-.15-.67.15-.2.3-.77.97-.94 1.16-.17.2-.35.23-.65.08-.3-.15-1.26-.46-2.39-1.48-.89-.79-1.48-1.76-1.65-2.06-.17-.3-.02-.46.13-.61.13-.13.3-.35.45-.52.15-.17.2-.3.3-.5.1-.2.05-.37-.02-.52-.08-.15-.67-1.61-.92-2.2-.24-.58-.48-.5-.67-.51h-.57c-.2 0-.52.08-.79.37-.27.3-1.04 1.02-1.04 2.48s1.06 2.88 1.21 3.08c.15.2 2.09 3.2 5.08 4.49.71.31 1.26.49 1.69.63.71.23 1.36.19 1.87.12.57-.09 1.76-.72 2.01-1.42.25-.69.25-1.29.17-1.41-.07-.12-.27-.2-.57-.35Z"/></svg><span>0851-8321-3414</span></a>',
    ],
  },
];
---

<BaseLayout title="FAQ | KESC & KEYSI 2027">
  <Navbar />
  <HeroHalaman
    judul="Frequently Asked Questions (FAQ)"
    subjudul="Jawaban untuk pertanyaan seputar program, pendaftaran, dan biaya kompetisi."
  />

  <!-- Section FAQ Umum -->
  <section class="bg-[#F5F5F5] px-6 py-16 md:px-[100px]">
    <div class="mx-auto flex w-full max-w-[1240px] flex-col gap-8">
      <h2
        class="font-['Poppins',sans-serif] text-[24px] font-semibold leading-[1.29] text-[#0F172A] md:text-[32px] md:leading-[1.25]"
      >
        Seputar KESC & KEYSI 2027
      </h2>

      <div class="flex flex-col gap-4">
        {
          daftarFaq.map((item, i) => (
            <details
              class="group w-full rounded-2xl border border-[#E2E8F0] bg-[#FAFAFA] shadow-[0_1px_1.5px_rgba(15,23,42,0.1)]"
              open={i === 0}
            >
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6">
                <span class="font-['Poppins',sans-serif] text-lg font-semibold leading-[1.35] text-[#0F172A] md:text-[20px]">
                  {item.pertanyaan}
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-6 shrink-0 text-[#0F172A] transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="flex flex-col gap-3 border-t border-[#E2E8F0] px-6 py-5">
                {item.jawaban.map((paragraf) => (
                  <p
                    class="whitespace-pre-line text-base leading-[1.63] text-[#475569]"
                    set:html={paragraf}
                  />
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <BantuanJadwal
    judul="Masih punya pertanyaan?"
    deskripsi="Hubungi Admin King Expert untuk informasi lebih lanjut."
/>
  <Footer />
</BaseLayout>