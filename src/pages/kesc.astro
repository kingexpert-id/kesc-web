---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
import HeroKesc from '../components/HeroKesc.astro';
import PanelSemangat from '../components/PanelSemangat.astro';
import JenjangCabang from '../components/JenjangCabang.astro';
import MekanismeKesc from '../components/MekanismeKesc.astro';
import KeuntunganKesc from '../components/KeuntunganKesc.astro';
import PosterSection from '../components/PosterSection.astro';
import CtaLangkah from '../components/CtaLangkah.astro';
import FaqKesc from '../components/FaqKesc.astro';
---

<BaseLayout title="KESC 2027 — King Expert Science Competition">
  <Navbar />
  <HeroKesc />

  <PanelSemangat
    paragraf="Di tahun 2027 ini, KESC mengangkat semangat “Growing with Science, Advancing with Technology” kami mengajak setiap peserta untuk terus bertumbuh dan melangkah maju sebagai bagian dari GenerAction of Science and Technology. Melalui berbagai tantangan inovatif dan menarik, KESC membantu peserta mengasah kemampuan, mempersiapkan diri sebelum OSN, dan menumbuhkan semangat eksplorasi ilmiah sejak dini."
    gambar="/images/panel-kesc.png"
    altGambar="Ilustrasi presenters sains dengan hologram"
    labelCta="Daftar KESC 2027"
    labelPanduan="Unduh panduan KESC"
    tautanDaftar="https://forms.fillout.com/t/9w7zjLbFLAus"
    tautanPanduan="https://drive.google.com/drive/folders/1mniI0Fz2ibXmKlYtp7ihBY-Fv574LU0I"
  />

  <JenjangCabang />
  <MekanismeKesc />
  <KeuntunganKesc />
  <PosterSection />
  <CtaLangkah 
    labelDaftar="Daftar KESC 2027"
    hrefDaftar="https://forms.fillout.com/t/9w7zjLbFLAus"
    hrefPanduan="https://drive.google.com/drive/folders/1mniI0Fz2ibXmKlYtp7ihBY-Fv574LU0I"
  />
  <FaqKesc />
  <Footer />
</BaseLayout>