  sertifikat: `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg"><path d="M13 22H18C18.5304 22 19.0391 21.7893 19.4142 21.4142C19.7893 21.0391 20 20.5304 20 20V8C20.0008 7.68311 19.9388 7.3692 19.8176 7.07639C19.6964 6.78358 19.5185 6.51767 19.294 6.294L15.706 2.706C15.4823 2.48152 15.2164 2.30356 14.9236 2.18238C14.6308 2.06121 14.3169 1.99922 14 2H6C5.46957 2 4.96086 2.21071 4.58579 2.58579C4.21071 2.96086 4 3.46957 4 4V7.3" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/><path d="M14 2V7C14 7.26522 14.1054 7.51957 14.2929 7.70711C14.4804 7.89464 14.7348 8 15 8H20" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/><path d="M7.69 16.479L8.98 21.359C9.00736 21.4519 9.00713 21.5508 8.97933 21.6436C8.95154 21.7364 8.89738 21.8192 8.82344 21.8818C8.74951 21.9444 8.65897 21.9842 8.56285 21.9963C8.46673 22.0084 8.36916 21.9923 8.282 21.95L6.439 21.101C6.30209 21.0342 6.15172 20.9996 5.99938 20.9997C5.84705 20.9999 5.69676 21.0349 5.56 21.102L3.714 21.952C3.62688 21.9928 3.52984 22.0076 3.43452 21.9946C3.3392 21.9817 3.24964 21.9415 3.17659 21.8789C3.10354 21.8163 3.0501 21.7339 3.02268 21.6417C2.99526 21.5495 2.99503 21.4513 3.022 21.359L4.312 16.479" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/><path d="M9 14C9 15.6569 7.65685 17 6 17C4.34315 17 3 15.6569 3 14C3 12.3431 4.34315 11 6 11C7.65685 11 9 12.3431 9 14Z" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" stroke="currentColor"/></svg>`,
