};

/* Wave transisi dari Figma node 477:2248 & 477:2251 — fill selaras dengan bg-surface-page (#F5F5F5) */
const wave = `<svg width="100%" height="100%" viewBox="0 0 1440 72" fill="none" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none"><path d="M0 39.5999C240 3.59988 360 68.3999 720 39.5999C1080 10.7999 1200 3.59988 1440 39.5999V71.9999H0V39.5999Z" fill="#F5F5F5"/></svg>`;

const penghargaanKeysi = [
  'Best Innovation',
  'Most Applicable Idea',
  'Best Scientific Paper',
  'Most Creative Video',
];
---

<section
  id="keuntungan"
  class:list={[
    'relative overflow-clip bg-[linear-gradient(140.08deg,var(--color-campaign-navy)_0%,var(--color-campaign-indigo-deep)_55%,var(--color-campaign-indigo)_100%)] px-6 py-20 md:px-12 lg:px-[100px] lg:py-[100px]',
    className,
  ]}
  data-node-id="470:1818"
>
  <!-- Wave transisi atas (dibalik 180° untuk menyambung dari section sebelumnya) -->
  <div
    class="pointer-events-none absolute inset-x-0 top-0 h-10 -rotate-180 -scale-x-100 overflow-hidden sm:h-14 lg:h-[72px]"
    aria-hidden="true"
    set:html={wave}
  ></div>

  <!-- Wave transisi bawah (menyambung ke section berikutnya) -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-10 overflow-hidden sm:h-14 lg:h-[72px]"
    aria-hidden="true"
    set:html={wave}
  ></div>

  <div class="relative mx-auto flex w-full max-w-[1030px] flex-col gap-8">
    <!-- Header Section -->
    <header class="flex flex-col items-center gap-3 text-center">
      <p class="font-sans text-body-sm font-normal tracking-[0.3px] text-surface-card">
        MANFAAT &amp; PENGALAMAN
      </p>
      <h2 class="font-heading text-h2 font-semibold text-surface-card">
        Keuntungan Mendaftar di KESC &amp; KEYSI 2027
      </h2>
    </header>

    <!-- Baris 1: Card 01 Apresiasi + (Card 02 Kemampuan & Card 03 Sertifikat) -->
    <div class="flex flex-col items-stretch gap-6 md:flex-row lg:gap-[30px]">
      <!-- 01 Apresiasi untuk Para Juara -->
      <article
        class="group flex flex-1 flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 min-w-0 transition-all duration-150 ease-out hover:border-brand-500 hover:shadow-lg md:w-1/2 lg:w-[524px] lg:shrink-0"
        data-node-id="1025:754"
      >
        <div class="flex items-start gap-2">
          <span class="rounded-lg bg-brand-50 p-2 font-sans text-body-sm tracking-[0.3px] text-campaign-indigo">
            KESC
          </span>
          <span class="rounded-lg bg-campaign-surface-lavender p-2 font-sans text-body-sm tracking-[0.3px] text-campaign-indigo">
            KEYSI
          </span>
        </div>
        <div class="relative h-[198px] w-full shrink-0 rounded-lg">
          <img
            src="/images/keuntungan-medali-plakat.png"
            alt="Medali KESC dan plakat KEYSI"
            width="1048"
            height="396"
            loading="lazy"
            class="pointer-events-none h-full w-full rounded-lg object-contain"
          />
        </div>
        <h3 class="font-heading text-h3 font-semibold text-slate-900 transition-colors duration-150 ease-out group-hover:text-brand-500">
          Apresiasi untuk Para Juara
        </h3>
        <p class="font-sans text-body text-slate-600">
          Raih Medali KESC atau Plakat di KEYSI sebagai bukti prestasimu!
        </p>
        <p class="font-heading text-body-sm font-semibold text-slate-900">
          Penghargaan kategori spesial di KEYSI
        </p>
        <ul class="grid w-full grid-cols-1 gap-2 sm:grid-cols-2">
          {
            penghargaanKeysi.map((label) => (
              <li class="rounded-lg bg-campaign-surface-lavender p-2 font-sans text-body-sm tracking-[0.3px] text-campaign-indigo">
                {label}
              </li>
            ))
          }
        </ul>
      </article>

      <!-- Kolom Kanan Baris 1: 02 Asah Kemampuan + 03 E-Sertifikat -->
      <div class="flex flex-1 flex-col justify-between gap-6 min-w-0 md:w-1/2 lg:w-[475px] lg:gap-[30px]" data-node-id="1025:775">
        <!-- 02 Asah Kemampuan -->
        <article
          class="group flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 transition-all duration-150 ease-out hover:border-brand-500 hover:shadow-lg"
          data-node-id="599:1678"
        >
          <div class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-brand-50 text-brand-500">
            <span class="block size-6" set:html={ikon.kemampuan} />
          </div>
          <h3 class="font-heading text-h3 font-semibold text-slate-900 transition-colors duration-150 ease-out group-hover:text-brand-500">
            Asah Kemampuan, Sesuai Minatmu
          </h3>
          <p class="font-sans text-body text-slate-600">
            Uji kemampuan akademismu lewat soal-soal berkualitas di KESC sebagai latihan dan
            persiapan sebelum Olimpiade Sains Nasional (OSN), Kompetisi Sains Madrasah (KSM), dan
            kompetisi sains lainnya! Atau kamu juga bisa asah berpikir kritis dan kreativitasmu
            lewat gagasan inovatif di KEYSI.
          </p>
        </article>

        <!-- 03 E-Sertifikat -->
        <article
          class="group flex flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 transition-all duration-150 ease-out hover:border-brand-500 hover:shadow-lg"
          data-node-id="599:1681"
        >
          <div class="flex items-center gap-4">
            <div class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-brand-50 text-brand-500">
              <span class="block size-6" set:html={ikon.sertifikat} />
            </div>
            <h3 class="flex-1 font-heading text-h3 font-semibold text-slate-900 transition-colors duration-150 ease-out group-hover:text-brand-500">
              E-Sertifikat
            </h3>
          </div>
          <p class="font-sans text-body text-slate-600">
            Seluruh peserta mendapatkan E-Sertifikat, mulai dari partisipasi hingga juara.
          </p>
        </article>
      </div>
    </div>

    <!-- Baris 2: Card 04 Kurasi + Card 05 Bertemu Pelajar -->
    <div class="flex flex-col items-stretch gap-6 md:flex-row lg:gap-[30px]">
      <!-- 04 Kurasi untuk Portofolio Prestasi -->
      <article
        class="group flex flex-col gap-4 rounded-xl border border-slate-200 bg-campaign-surface-lavender p-6 min-w-0 transition-all duration-150 ease-out hover:border-brand-500 hover:shadow-lg md:w-3/5 lg:w-[654px] lg:shrink-0"
        data-node-id="1023:826"
      >
        <div class="flex items-center gap-4">
          <div class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-brand-50 text-brand-500">
            <span class="block size-6" set:html={ikon.kurasi} />
          </div>
          <h3 class="flex-1 font-heading text-h3 font-semibold text-slate-900 transition-colors duration-150 ease-out group-hover:text-brand-500">
            Kurasi untuk Portofolio Prestasi
          </h3>
        </div>
        <p class="font-sans text-body text-slate-600">
          King Expert selalu berupaya memperbarui status kurasi di setiap tahun agar sertifikat
          juara yang lolos verifikasi dapat diajukan oleh sekolah ke Sistem Informasi Manajemen
          Talenta (SIMT) sebagai portofolio valid untuk pendaftaran Seleksi Nasional Berdasarkan
          Prestasi (SNBP), Penerimaan Peserta Didik Baru (PPDB)/Seleksi Penerimaan Murid Baru
          (SPMB), serta pendukung pengajuan beasiswa.
        </p>
        <div class="mt-auto py-2 font-sans text-body-sm tracking-[0.3px] text-campaign-indigo">
          Pengajuan mengikuti verifikasi sertifikat
        </div>
      </article>

      <!-- 05 Bertemu Pelajar & Mahasiswa -->
      <article
        class="group flex flex-1 flex-col gap-4 rounded-xl border border-slate-200 bg-white p-6 min-w-0 transition-all duration-150 ease-out hover:border-brand-500 hover:shadow-lg md:w-2/5 lg:w-[345px]"
        data-node-id="1023:829"
      >
        <div class="flex size-12 shrink-0 items-center justify-center rounded-lg border border-slate-200 bg-brand-50 text-brand-500">
          <span class="block size-6" set:html={ikon.bertemu} />
        </div>
        <h3 class="font-heading text-h3 font-semibold text-slate-900 transition-colors duration-150 ease-out group-hover:text-brand-500">
          Bertemu Pelajar &amp; Mahasiswa dari Seluruh Indonesia
        </h3>
        <p class="font-sans text-body text-slate-600">
          Tambah relasi pertemanan dan bersaing bersama peserta dari berbagai wilayah di Indonesia!
        </p>
      </article>
    </div>
  </div>
</section>
