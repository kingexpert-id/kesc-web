---
// Section Arsip Dokumen — halaman Pengumuman (Figma 681:2232)
// Tautan "#" = dokumen belum tersedia; ganti dengan link Google Drive saat sudah ada.
const daftarSoal = [
  { tahun: "KESC 2026", tautan: "https://forms.fillout.com/t/hmPh11LdZVus" },
  { tahun: "KESC 2025", tautan: "https://forms.fillout.com/t/hmPh11LdZVus" },
];
const daftarSK = [
  {
    tahun: "KESC 2026",
    dokumen: [
      { nama: "SK Penetapan Finalis KESC 2026", tautan: "https://drive.google.com/file/d/1AcsR13Yc2E6KInB0Fkv1mcF4yUpmh6oJ/view?usp=sharing" },
      { nama: "SK Penetapan Pemenang KESC 2026", tautan: "https://drive.google.com/file/d/17hhMwNyQO34IHM7fHrsy-3Qnh9-kQcKI/view?usp=sharing" },
    ],
  },
  {
    tahun: "KESC 2025",
    dokumen: [
      { nama: "SK Penetapan Finalis KESC 2025", tautan: "https://drive.google.com/file/d/1uE-fDiBU9VBS2m7oqWbo-beAyJVzgGr7/view?usp=drive_link" },
      { nama: "SK Penetapan Pemenang KESC 2025", tautan: "https://drive.google.com/file/d/1frJTMEU0iaZUvwJ5k1l6blgvmBRTrA1A/view?usp=sharing" },
    ],
  },
];
---

<section class="bg-[#F5F5F5] px-6 py-16 md:px-[100px]">
  <div class="mx-auto w-full max-w-[1240px]">
    <div class="grid grid-cols-1 gap-[30px] md:grid-cols-2">
      <!-- Kolom 1: Soal & Pembahasan -->
      <div class="flex flex-col gap-6">
        <div class="flex w-full items-start gap-4">
          <img
            src="/images/pengumuman-soal.png"
            alt="Ilustrasi arsip soal"
            class="h-16 w-16 shrink-0"
            width="64"
            height="64"
            loading="lazy" />
          <div class="flex flex-1 flex-col gap-2">
            <h2
              class="font-['Poppins',sans-serif] text-[20px] font-semibold leading-[1.29] text-[#0F172A] md:text-[24px] md:leading-[31px]">
              Akses Soal dan Pembahasan KESC
            </h2>
            <p class="text-base leading-[1.63] text-[#475569]">
              Arsip soal kompetisi dan pembahasannya.
            </p>
          </div>
        </div>

        {
          daftarSoal.map((item) => (
            <a
              href={item.tautan}
              class="flex h-[72px] w-full items-center justify-between rounded-2xl border border-[#E2E8F0] bg-[#FAFAFA] px-6 py-3 shadow-[0_1px_3px_rgba(15,23,42,0.1)]"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="size-6 shrink-0 text-[#0F172A]"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                <path d="M10 9H8" />
                <path d="M16 13H8" />
                <path d="M16 17H8" />
              </svg>
              <span class="font-['Poppins',sans-serif] text-[20px] font-semibold text-black md:text-[24px]">
                {item.tahun}
              </span>
              <span
                class="flex h-12 w-[150px] shrink-0 items-center justify-center rounded-2xl bg-[#004AAD] font-['Poppins',sans-serif] text-base font-semibold text-[#FAFAFA] md:w-[182px]"
              >
                Unduh
              </span>
            </a>
          ))
        }
      </div>

      <!-- Kolom 2: Ketentuan & SK -->
      <div class="flex flex-col gap-6">
        <div class="flex w-full items-start gap-4">
          <img
            src="/images/pengumuman-sk.png"
            alt="Ilustrasi surat keputusan"
            class="h-16 w-16 shrink-0"
            width="64"
            height="64"
            loading="lazy" />
          <div class="flex flex-1 flex-col gap-2">
            <h2
              class="font-['Poppins',sans-serif] text-[20px] font-semibold leading-[1.29] text-[#0F172A] md:text-[24px] md:leading-[31px]">
              Ketentuan dan Surat Keputusan KESC
            </h2>
            <p class="text-base leading-[1.63] text-[#475569]">
              Arsip penetapan finalis dan pemenang.
            </p>
          </div>
        </div>

        {
          daftarSK.map((grup) => (
            <details class="group w-full rounded-2xl border border-[#E2E8F0] bg-[#FAFAFA] shadow-[0_1px_1.5px_rgba(15,23,42,0.1)]">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 p-6">
                <span class="font-['Poppins',sans-serif] text-[20px] font-semibold leading-[31px] text-[#0F172A] md:text-[24px]">
                  {grup.tahun}
                </span>
                <svg
                  xmlns="http://www.w3.org/2000/svg"
                  class="size-6 shrink-0 text-[#0F172A] transition-transform duration-200 group-open:rotate-180"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <path d="m6 9 6 6 6-6" />
                </svg>
              </summary>
              <div class="flex w-full flex-col gap-3 px-6 pb-6">
                {grup.dokumen.map((dok) => (
                  <div class="flex w-full items-center gap-4 rounded-xl bg-[#F0F6FF] p-4">
                    <svg
                      xmlns="http://www.w3.org/2000/svg"
                      class="size-6 shrink-0 text-[#0F172A]"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z" />
                      <path d="M14 2v4a2 2 0 0 0 2 2h4" />
                      <path d="M10 9H8" />
                      <path d="M16 13H8" />
                      <path d="M16 17H8" />
                    </svg>
                    <span class="flex-1 font-['Poppins',sans-serif] text-base font-semibold leading-[24px] text-[#0F172A]">
                      {dok.nama}
                    </span>
                    <a
                      href={dok.tautan}
                      class="flex h-12 shrink-0 items-center justify-center rounded-2xl bg-[#004AAD] px-6 font-['Poppins',sans-serif] text-base font-semibold text-[#FAFAFA]"
                    >
                      Unduh
                    </a>
                  </div>
                ))}
              </div>
            </details>
          ))
        }
      </div>
    </div>

    <!-- Catatan info -->
    <div class="mt-8 flex w-full items-center gap-4 rounded-2xl bg-[#F0F6FF] p-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        class="size-6 shrink-0 text-[#0F172A]"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>
      <p class="flex-1 text-base leading-[1.63] text-[#475569]">
        Tautan dokumen belum tersedia. Tombol Unduh akan aktif setelah tautan resmi ditambahkan.
      </p>
    </div>
  </div>
</section>