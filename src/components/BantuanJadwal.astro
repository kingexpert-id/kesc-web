
---
interface Props {
  judul?: string;
  deskripsi?: string;
  teksTombol?: string;
  tautanWa?: string;
}

const {
  judul = 'Butuh bantuan seputar jadwal?',
  deskripsi = 'Hubungi Admin King Expert untuk informasi lebih lanjut.',
  teksTombol = 'Tanya Admin King Expert',
  tautanWa = 'https://wa.me/6285183213414',
} = Astro.props;
---

<section class="px-6 pb-16 md:px-14 lg:px-[100px] min-[1440px]:px-[100px]">
  <div
    class="mx-auto flex max-w-[1240px] flex-col items-center gap-6 rounded-xl border border-[#E2E8F0] bg-[#EEEAFE] p-6 shadow-[0_1px_1.5px_rgba(15,23,42,0.10)] md:flex-row"
  >
    <!-- Content -->
    <div class="min-w-0 flex-1">
      <h3 class="text-h3 font-semibold text-[#0F172A]">
        {judul}
      </h3>

      <p class="mt-3 text-body text-[#475569]">
        {deskripsi}
      </p>

      <!-- WhatsApp CTA -->
      <a
        href={tautanWa}
        target="_blank"
        rel="noopener noreferrer"
        aria-label={`${teksTombol} melalui WhatsApp`}
        class="mt-6 inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-5 text-base font-semibold leading-4 text-[#0F172A] transition-colors duration-200 hover:bg-[#20BD5A] focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[#0F172A] sm:w-[300px]"
      >
        <img
          src="/images/whatsapp.svg"
          alt=""
          aria-hidden="true"
          width="20"
          height="20"
          class="size-5 shrink-0 object-contain"
        />

        <span class="whitespace-nowrap">
          {teksTombol}
        </span>
      </a>
    </div>

    <!-- Illustration -->
    <img
      src="/images/bantuan-jadwal.png"
      alt="Ilustrasi siswa juara yang ceria"
      width="766"
      height="432"
      loading="lazy"
      class="h-auto w-full max-w-[463px]"
    />
  </div>
</section>
