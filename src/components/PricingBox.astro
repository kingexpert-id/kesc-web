---
interface Props {
  eyebrow: string;
  judul: string;
  subjudul: string;
  catatan: string;
  labelCta: string;
  tautanDaftar: string;
  regular: { harga: string; periode: string; keterangan: string };
  early: { harga: string; periode: string; keterangan: string };
}

const { eyebrow, judul, subjudul, catatan, labelCta, tautanDaftar, regular, early } = Astro.props;
---

<div class="mx-auto w-full max-w-[1240px] rounded-2xl border border-[#E2E8F0] bg-white p-6 shadow-[0_1px_2px_rgba(15,23,42,0.08)] md:p-8">
  <div class="flex flex-col items-center gap-2 text-center">
    <p class="text-sm font-semibold uppercase tracking-[1.5px] text-[#004AAD]">{eyebrow}</p>
    <h2 class="text-h2 font-semibold text-[#0F172A]">{judul}</h2>
    <p class="text-body text-[#475569]">{subjudul}</p>
  </div>
  <div class="mt-8 grid gap-6 md:grid-cols-2">
    <!-- Regular -->
    <div class="flex flex-col gap-3 rounded-2xl border border-[#E2E8F0] bg-[#FAFAFA] p-6">
      <p class="text-sm font-semibold uppercase tracking-[1.5px] text-[#5053A2]">Regular</p>
      <div class="flex items-end gap-2">
        <p class="text-[40px] font-bold leading-none text-[#0F172A]">{regular.harga}</p>
        <p class="pb-1 text-sm text-[#475569]">/peserta atau tim</p>
      </div>
      <p class="text-body font-semibold text-[#0F172A]">{regular.periode}</p>
      <p class="text-sm text-[#475569]">{regular.keterangan}</p>
      <a
        href={tautanDaftar}
        target="_blank"
        rel="noopener"
        class="mt-auto inline-flex h-12 items-center justify-center rounded-xl border border-[#004AAD] px-5 text-base font-semibold text-[#004AAD] transition hover:bg-[#004AAD]/5"
      >
        {labelCta}
      </a>
    </div>
    <!-- Early Bird -->
    <div
      class="relative flex flex-col gap-3 overflow-hidden rounded-2xl p-6 text-[#FAFAFA]"
      style="background-image: linear-gradient(to bottom, #004AAD, #003985);"
    >
      <span class="absolute right-4 top-4 rounded-full bg-[#F5B903] px-3 py-1 text-xs font-bold text-[#0F172A]">
        PALING HEMAT
      </span>
      <p class="text-sm font-semibold uppercase tracking-[1.5px] text-[#FAFAFA]/80">Early Bird</p>
      <div class="flex items-end gap-2">
        <p class="text-[40px] font-bold leading-none">{early.harga}</p>
        <p class="pb-1 text-sm text-[#FAFAFA]/80">/peserta atau tim</p>
      </div>
      <p class="text-body font-semibold">{early.periode}</p>
      <p class="text-sm text-[#FAFAFA]/80">{early.keterangan}</p>
      <a
        href={tautanDaftar}
        target="_blank"
        rel="noopener"
        class="mt-auto inline-flex h-12 items-center justify-center rounded-xl bg-[#FAFAFA] px-5 text-base font-semibold text-[#004AAD] transition hover:opacity-90"
      >
        {labelCta}
      </a>
    </div>
  </div>
  <p class="mt-6 text-center text-sm text-[#475569]">{catatan}</p>
</div>