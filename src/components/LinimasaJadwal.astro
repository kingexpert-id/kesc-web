const daftarBulan = ['November 2026', 'Januari 2027'];

const jumlahKegiatan = {
  Semua: 12,
  KESC: 9,
  KEYSI: 5,
};

const deskripsiJumlah = {
  Semua: 'KESC, KEYSI & agenda bersama',
  KESC: 'KESC & agenda bersama',
  KEYSI: 'KEYSI & agenda bersama',
};
---

<section
  class="w-full bg-[#F5F5F5] px-6 py-8 md:px-14 md:py-12 lg:px-[100px] lg:py-16"
  data-linimasa
>
  <div class="mx-auto w-full max-w-[1240px]">

    <!-- Toolbar -->
    <div
      class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between"
    >
      <div class="flex flex-col gap-2">
        <p class="font-['Poppins'] text-sm font-semibold leading-[1.45] text-[#004AAD]">
          JADWAL KESC & KEYSI
        </p>

        <h2 class="font-['Poppins'] text-[26px] font-semibold leading-[1.45] text-[#0F172A] md:text-[32px]">
          Linimasa Kompetisi
        </h2>

        
        <p class="font-['Noto_Sans'] text-base leading-[1.65] text-[#475569]">
          Pilih program untuk melihat jadwal yang relevan.
        </p>
      </div>

      <!-- Filter -->
      <div
        class="grid w-full grid-cols-3 gap-1 rounded-[10px] border border-[#E2E8F0] bg-white p-1 md:w-[306px]"
        role="group"
        aria-label="Filter jadwal kompetisi"
      >
        {['Semua', 'KESC', 'KEYSI'].map((filter) => (
          <button
            type="button"
            data-filter={filter}
            aria-pressed={filter === 'Semua' ? 'true' : 'false'}
            class:list={[
              'flex min-h-11 items-center justify-center rounded-md px-2 py-3',
              'font-["Poppins"] text-sm font-semibold leading-[1.45]',
              'transition-colors duration-200',
              filter === 'Semua'
                ? 'bg-[#004AAD] text-[#FAFAFA]'
                : 'bg-transparent text-[#475569] hover:bg-[#F1F5F9]',
            ]}
          >
            {filter}
          </button>
        ))}
      </div>
    </div>

    <!-- Rentang tanggal dan jumlah kegiatan -->
    <div class="mt-8 flex flex-col gap-1 text-sm md:flex-row md:flex-wrap md:items-center md:gap-3">
      <p class="font-['Poppins'] font-semibold leading-[1.45] text-[#1E2B65]">
        06 Nov 2026 — 24 Jan 2027
      </p>

      <p class="font-['Noto_Sans'] leading-[1.65] text-[#475569]">
        <span data-count>12</span> kegiatan ·
        <span data-count-description>
          KESC, KEYSI & agenda bersama
        </span>
      </p>
    </div>

    <!-- Timeline -->
    <div class="mt-8">

      {daftarBulan.map((bulan) => {
        const kegiatanBulan = kegiatan.filter(
          (item) => item.bulan === bulan
        );

        return (
          <div
            class="timeline-month"
            data-month={bulan}
          >
            <!-- Month heading -->
            <div class="mb-6 flex items-center gap-6 pt-2">
              <h3 class="shrink-0 bg-[#F5F5F5] pr-4 font-['Poppins'] text-xl font-semibold leading-[1.45] text-[#0F172A] md:text-[22px]">
                {bulan}
              </h3>

              <div class="h-px min-w-0 flex-1 bg-[#E2E8F0]"></div>
            </div>

            <!-- Activities -->
            <div class="timeline-events relative">
              {kegiatanBulan.map((item) => (
                <article
                  class="timeline-event relative grid grid-cols-[64px_minmax(0,1fr)] items-start gap-4 pb-6 md:grid-cols-[88px_80px_minmax(0,1fr)] md:gap-5 md:pb-10 lg:grid-cols-[112px_96px_minmax(0,1fr)] lg:gap-8"
                  data-program={item.program}
                >
                  <!-- Date: mobile -->
                  <div class="col-start-2 row-start-1 flex flex-wrap items-center gap-2 pt-1 md:hidden">
                    <p class="font-['Poppins'] text-sm font-semibold leading-[1.45] text-[#1E2B65]">
                      {item.tanggal} {item.tahun}
                    </p>
                  </div>

                  <!-- Date: tablet and desktop -->
                  <div class="hidden flex-col gap-1 pt-4 lg:pt-6 md:col-start-1 md:row-start-1 md:flex">
                    <p class="font-['Poppins'] text-base font-semibold leading-[1.45] text-[#1E2B65] lg:text-lg">
                      {item.tanggal}
                    </p>

                    <p class="font-['Noto_Sans'] text-sm leading-[1.65] text-[#475569]">
                      {item.tahun}
                    </p>
                  </div>

                  <!-- Illustration -->
                  <div class="relative col-start-1 row-span-2 row-start-1 flex size-16 items-center justify-center md:col-start-2 md:row-span-1 md:size-20 lg:size-24">
                    <img
                      src={ikonTipe[item.ikon]}
                      alt=""
                      aria-hidden="true"
                      width="96"
                      height="96"
                      loading="lazy"
                      class="relative z-[1] size-full object-contain"
                    />
                  </div>

                  <!-- Activity detail -->
                  <div class="col-start-2 row-start-2 flex min-h-[112px] min-w-0 flex-col gap-2 border-b border-[#E2E8F0] pb-6 pt-1 md:col-start-3 md:row-start-1 md:pt-3 lg:pt-5">
                    <div class="flex flex-col items-start gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-3">
                      <h4 class="order-2 min-w-0 flex-1 font-['Poppins'] text-lg font-semibold leading-[1.45] text-[#0F172A] sm:order-1">
                        {item.judul}
                      </h4>

                      <span
                        class:list={[
                          'order-1 sm:order-2',
                          'inline-flex shrink-0 items-center rounded-md px-2 py-1',
                          'font-["Poppins"] text-sm font-semibold leading-[1.45]',
                          badgeKelas[item.program],
                        ]}
                      >
                        {item.program}
                      </span>
                    </div>

                    <p class="font-['Noto_Sans'] text-base leading-[1.65] text-[#475569]">
                      {item.deskripsi}
                    </p>
                    {item.cta && (
                      <a
                        href="https://forms.fillout.com/t/9w7zjLbFLAus"
                        class="inline-flex h-10 items-center justify-center rounded-2xl bg-[#004AAD] px-4 font-['Poppins'] text-sm font-semibold leading-[1.45] text-[#FAFAFA] lg:hidden"
                      >
                        Daftar Sekarang
                      </a>
                    )}
                  </div>
                </article>
              ))}
            </div>
          </div>
        );
      })}
    </div>

    <!-- Footnote -->
    <div class="mt-2 flex items-center gap-4 rounded-2xl bg-[#F0F6FF] p-6">
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="24"
        height="24"
        viewBox="0 0 24 24"
        fill="none"
        stroke="#004AAD"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="shrink-0"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M12 16v-4"></path>
        <path d="M12 8h.01"></path>
      </svg>

      <p class="font-['Noto_Sans'] text-xs leading-[1.65] text-[#475569] md:text-sm">
        Jarak antarkegiatan disesuaikan dengan isi, bukan skala durasi tanggal.
        Kegiatan pada tanggal yang sama tetap ditampilkan terpisah.
      </p>
    </div>

  </div>
</section>

<script>
  const initLinimasa = (root: HTMLElement) => {
    const filterButtons = root.querySelectorAll<HTMLButtonElement>(
      '[data-filter]'
    );

    const events = root.querySelectorAll<HTMLElement>(
      '[data-program]'
    );

    const months = root.querySelectorAll<HTMLElement>(
      '[data-month]'
    );

    const countElement = root.querySelector<HTMLElement>(
      '[data-count]'
    );

    const descriptionElement = root.querySelector<HTMLElement>(
      '[data-count-description]'
    );

    const jumlahKegiatan: Record<string, number> = {
      Semua: 12,
      KESC: 9,
      KEYSI: 5,
    };

    const deskripsiJumlah: Record<string, string> = {
      Semua: 'KESC, KEYSI & agenda bersama',
      KESC: 'KESC & agenda bersama',
      KEYSI: 'KEYSI & agenda bersama',
    };

    const setFilter = (filter: string) => {
      events.forEach((event) => {
        const program = event.dataset.program;

        const tampil =
          filter === 'Semua' ||
          program === filter ||
          program === 'Bersama';

        event.hidden = !tampil;
      });

      months.forEach((month) => {
        const visibleEvents = month.querySelectorAll(
          '[data-program]:not([hidden])'
        );

        month.hidden = visibleEvents.length === 0;
      });

      filterButtons.forEach((button) => {
        const aktif = button.dataset.filter === filter;

        button.setAttribute('aria-pressed', String(aktif));

        button.classList.toggle('bg-[#004AAD]', aktif);
        button.classList.toggle('text-[#FAFAFA]', aktif);

        button.classList.toggle('bg-transparent', !aktif);
        button.classList.toggle('text-[#475569]', !aktif);
      });

      if (countElement) {
        countElement.textContent = String(jumlahKegiatan[filter]);
      }

      if (descriptionElement) {
        descriptionElement.textContent = deskripsiJumlah[filter];
      }
    };

    filterButtons.forEach((button) => {
      button.addEventListener('click', () => {
        const filter = button.dataset.filter;

        if (filter) {
          setFilter(filter);
        }
      });
    });

    setFilter('Semua');
  };

  document.querySelectorAll<HTMLElement>('[data-linimasa]').forEach(
    initLinimasa
  );
</script>

<style>
  .timeline-events {
    position: relative;
  }

  .timeline-events::before {
    content: '';
    position: absolute;
    z-index: 0;
    top: 0;
    bottom: 32px;
    left: 31px;
    border-left: 2px dashed #94a3b8;
    pointer-events: none;
  }

  .timeline-event:last-child {
    padding-bottom: 24px;
  }

  .timeline-event[hidden],
  .timeline-month[hidden] {
    display: none;
  }

  @media (min-width: 768px) {
    .timeline-events::before {
      left: 148px;
    }
  }

  @media (min-width: 1024px) {
    .timeline-events::before {
      left: 192px;
    }
  }
</style>