---
type IkonTipe =
  | 'pendaftaran'
  | 'tenggat'
  | 'briefing'
  | 'ujian'
  | 'pengumuman'
  | 'pengumpulan'
  | 'penjurian'
  | 'pemenang';

type Program = 'KESC' | 'KEYSI' | 'Bersama';

const ikonTipe: Record<IkonTipe, string> = {
  pendaftaran: '/images/jadwal-pendaftaran.png',
  tenggat: '/images/jadwal-tenggat.png',
  briefing: '/images/jadwal-briefing.png',
  ujian: '/images/jadwal-ujian.png',
  pengumuman: '/images/jadwal-pengumuman.png',
  pengumpulan: '/images/jadwal-pengumpulan.png',
  penjurian: '/images/jadwal-penjurian.png',
  pemenang: '/images/jadwal-pemenang.png',
};

const badgeKelas: Record<Program, string> = {
  KESC: 'bg-[#F0F6FF] text-[#004AAD]',
  KEYSI: 'bg-[#EEEAFE] text-[#5053A2]',
  Bersama: 'bg-[#F1F5F9] text-[#475569]',
};

type Kegiatan = {
  tanggal: string;
  tahun: string;
  bulan: string;
  program: Program;
  judul: string;
  deskripsi: string;
  ikon: IkonTipe;
  cta?: boolean;
};

const kegiatan: Kegiatan[] = [
  {
    tanggal: '06 Nov',
    tahun: '2026',
    bulan: 'November 2026',
    program: 'Bersama',
    judul: 'Pembukaan Pendaftaran KESC & KEYSI',
    deskripsi:
      'Pendaftaran dibuka mulai tanggal 6 November 2026. Yuk, Daftar Sekarang!',
    ikon: 'pendaftaran',
    cta: true,
  },
  {
    tanggal: '12 Jan',
    tahun: '2027',
    bulan: 'Januari 2027',
    program: 'KESC',
    judul: 'Penutupan Pendaftaran KESC',
    deskripsi:
      'Penutupan Pendaftaran KESC pada 12 Januari 2027.',
    ikon: 'tenggat',
  },
  {
    tanggal: '14 Jan',
    tahun: '2027',
    bulan: 'Januari 2027',
    program: 'KESC',
    judul: 'Technical Meeting Regional Round KESC',
    deskripsi:
      'Dilaksanakan secara daring (online) melalui Zoom Meeting pada 14 Januari 2027.',
    ikon: 'briefing',
  },
  {
    tanggal: '16 Jan',
    tahun: '2027',
    bulan: 'Januari 2027',
    program: 'KESC',
    judul: 'Grand Opening & Babak Regional KESC',
    deskripsi:
      'Dilaksanakan pada 16 Januari 2027 secara daring (online) dengan pengawasan melalui Zoom dan dilaksanakan menggunakan CBT (Computer Based Test).',
    ikon: 'ujian',
  },
  {
    tanggal: '18 Jan',
    tahun: '2027',
    bulan: 'Januari 2027',
    program: 'KESC',
    judul: 'Pengumuman Babak Regional KESC',
    deskripsi:
      'Hasil regional diumumkan pada 18 Januari 2027 melalui media sosial resmi @kesc.id.',
    ikon: 'pengumuman',
  },
  {
    tanggal: '18 Jan',
    tahun: '2027',
    bulan: 'Januari 2027',
    program: 'KEYSI',
    judul: 'Penutupan Pendaftaran KEYSI',
    deskripsi:
      'Penutupan Pendaftaran KEYSI pada tanggal 18 Januari 2027.',
    ikon: 'tenggat',
  },
  {
    tanggal: '20 Jan',
    tahun: '2027',
    bulan: 'Januari 2027',
    program: 'KEYSI',
    judul: 'Batas Akhir Pengumpulan Karya KEYSI',
    deskripsi:
      'Pengumpulan karya KEYSI pada 20 Januari 2027, berupa esai dan video pendukung. Video bersifat opsional.',
    ikon: 'pengumpulan',
  },
  {
    tanggal: '21 Jan',
    tahun: '2027',
