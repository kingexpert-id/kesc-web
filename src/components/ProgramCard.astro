---
// Program / Card
interface Props {
  kategori: string;
  nama: string;
  overline: string;
  judul: string;
  deskripsi: string;
  chips: string[];
  ctaLabel: string;
  linkLabel: string;
  linkhref: string;
  gambar: string;
  alt: string;
}
const { kategori, nama, overline, judul, deskripsi, chips, ctaLabel, linkLabel, linkhref, gambar, alt } = Astro.props;
---

<article class="flex w-full flex-col overflow-hidden rounded-2xl border border-[#E2E8F0] bg-[#FAFAFA] transition duration-200 hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-900/10">
  <div class="relative h-[180px] w-full overflow-hidden bg-[linear-gradient(160.23deg,var(--color-campaign-navy)_0%,var(--color-campaign-indigo-deep)_76.06%,var(--color-campaign-indigo)_100%)]">
    <img src={gambar} alt={alt} width="1000" height="360" class="absolute inset-0 h-full w-full object-cover" />
    <p class="absolute left-6 right-6 top-4 font-sans text-xs leading-[17px] tracking-[0.3px] text-[#fafafa]">{kategori}</p>
    <p class="absolute left-6 top-[60px] font-heading text-h1 font-bold text-[#fafafa]">{nama}</p>
    <p class="absolute bottom-4 left-6 font-sans text-xs leading-[17px] tracking-[0.3px] text-[#fafafa]">PROGRAM / 2027</p>
  </div>
  <div class="flex w-full flex-col items-start gap-6 p-6">
    <div class="flex w-full flex-col items-start gap-4">
      <div class="flex w-full flex-col items-start gap-3">
        <p class="font-heading text-xs font-semibold leading-[17px] tracking-[1px] text-[#004AAD]">{overline}</p>
        <h3 class="font-heading text-h3 font-semibold text-slate-900">{judul}</h3>
      </div>
      <p class="font-sans text-body-lg text-slate-600">{deskripsi}</p>
    </div>
    <div class="flex w-full flex-col items-start gap-3 border-t border-[#E2E8F0] pt-4">
      <p class="font-heading text-xs font-semibold leading-[17px] tracking-[1px] text-slate-600">UNTUK JENJANG</p>
      <div class="flex w-full flex-wrap gap-2">
        {chips.map((c) => (
          <span class="rounded-lg border border-brand-100 bg-brand-50 px-3 py-1 font-sans text-sm leading-[21px] tracking-[0.3px] text-brand-700">{c}</span>
        ))}
      </div>
    </div>
    <div class="flex w-full flex-col items-start gap-3">
      <a href="https://forms.fillout.com/t/9w7zjLbFLAus" target="_blank" rel="noopener noreferrer" class="flex h-12 w-full items-center justify-center rounded-lg bg-brand-500 font-heading text-base font-semibold leading-4 text-[#fafafa] transition-colors active:bg-brand-700 hover:bg-brand-600">
        {ctaLabel}
      </a>
      <div class="flex flex-wrap w-full items-center gap-3 lg:flex-nowrap">
        <a href={linkhref} class="group whitespace-nowrap flex h-11 flex-1 items-center gap-1.5 font-heading text-sm font-semibold leading-[21px] text-[#004AAD] transition-colors hover:text-brand-600">
          {linkLabel}
          <svg class="h-4 w-4 shrink-0 transition-transform group-hover:translate-x-0.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14" /><path d="m12 5 7 7-7 7" /></svg>
        </a>
        <a href="https://wa.me/6285183213414" class="flex h-12 items-center gap-2 rounded-xl px-5 font-heading text-base font-semibold leading-4 text-[#004AAD] transition-colors hover:bg-brand-50 active:bg-brand-100">
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.88-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.297.347-.495.115-.198.058-.372-.03-.521-.087-.148-.66-1.59-.905-2.178-.24-.579-.487-.501-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" /></svg>
          Tanya Admin
        </a>
      </div>
    </div>
  </div>
</article>