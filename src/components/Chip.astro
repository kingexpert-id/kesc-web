interface Props {
  class?: string;
}
const { class: className = '' } = Astro.props;
---

<span class:list={['inline-flex items-center rounded-full px-3 py-1 text-sm leading-[21px] font-sans', 'bg-teal-50 text-teal-700', className]}>
  <slot />
