---
const tautanFaq = '/faq'; 
const tautanWa = 'https://wa.me/6285183213414'; // TODO: ganti dengan nomor WhatsApp admin
---

<section class="bg-[#F5F5F5] px-6 py-12 md:px-14 lg:px-[72px] min-[1440px]:px-[100px]">
  <div class="mx-auto flex max-w-[1240px] flex-col gap-6 lg:flex-row lg:gap-[30px]">
    <!-- Kartu FAQ -->
    <article
      class="flex flex-1 flex-col gap-6 rounded-xl border border-slate-200 bg-[#EEEAFE] p-6 drop-shadow-[0_1px_1.5px_rgba(15,23,42,0.10)] md:flex-row md:items-center"
    >
      <img
        src="/images/bantuan-faq.png"
        alt="Ilustrasi FAQ"
        width="320"
        height="386"
        loading="lazy"
        class="order-first h-[120px] w-[100px] shrink-0 rounded-lg object-contain md:order-last md:h-[169px] md:w-[140px] lg:h-[193px] lg:w-40"
      />
      <div class="flex flex-1 flex-col items-start gap-4">
        <h3 class="text-h3 font-semibold text-slate-900">
          Masih bingung mau ikut KESC atau KEYSI?
        </h3>
        <p class="text-body text-slate-600">
          Cek FAQ buat tahu bedanya dan cari jawaban cepat seputar pendaftaran.
        </p>
        <a
          href={tautanFaq}
          class="flex h-16 w-full items-center justify-center rounded-2xl bg-[#F38D4A] px-6 text-base font-semibold text-slate-900 transition hover:opacity-90 active:opacity-80 md:h-12 md:w-auto"
        >
          Cek Frequently Asked Questions (FAQ)
        </a>
      </div>
    </article>

    <!-- Kartu Admin -->
    <article
      class="flex flex-1 flex-col gap-6 rounded-xl border border-slate-200 bg-[#EEEAFE] p-6 drop-shadow-[0_1px_1.5px_rgba(15,23,42,0.10)] md:flex-row md:items-center"
    >
      <img
        src="/images/bantuan-admin.png"
        alt="Ilustrasi admin siap membantu"
        width="320"
        height="450"
        loading="lazy"
        class="order-first h-[140px] w-[100px] shrink-0 rounded-lg object-contain md:order-last md:h-[197px] md:w-[140px] lg:h-[225px] lg:w-40"
      />
      <div class="flex flex-1 flex-col items-start gap-4">
        <h3 class="text-h3 font-semibold text-slate-900">
          Baru pertama kali ikut dan tertarik coba kompetisi KESC &amp; KEYSI?
        </h3>
        <p class="text-body text-slate-600">
          Jangan khawatir! Kamu bisa konsultasi dulu sama Admin, kita siap bantu 😊
        </p>
        <a
          href={tautanWa}
          target="_blank"
          rel="noopener"
          class="flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-[#25D366] px-5 text-base font-semibold text-slate-900 transition hover:opacity-90 active:opacity-80 md:w-auto"
        >
          <svg
            role="img"
            viewBox="0 0 24 24"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            fill="#0F172A"
            aria-hidden="true"
          >
            <title>WhatsApp</title>
            <path
              d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413Z"
            ></path>
          </svg>
          Tanya Admin King Expert
        </a>
      </div>
    </article>
  </div>
</section>