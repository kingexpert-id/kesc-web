<section class="bg-[#F5F5F5] px-6 py-16 md:px-14 lg:px-[72px] min-[1440px]:px-[100px]">
  <div class="mx-auto flex max-w-[1240px] flex-col items-center gap-12 lg:flex-row lg:gap-[126px]">
