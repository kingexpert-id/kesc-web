            href={tautanDaftar}
            target="_blank"
            rel="noopener"
            class="inline-flex h-12 items-center justify-center rounded-xl bg-[#004AAD] px-5 text-base font-semibold text-[#FAFAFA] transition hover:opacity-90 active:opacity-80"
