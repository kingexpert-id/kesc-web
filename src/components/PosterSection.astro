---

<section class="bg-[#F5F5F5] px-6 py-14 md:px-14 lg:px-[72px] min-[1440px]:px-[100px]">
  <div class="mx-auto flex max-w-[1240px] flex-col items-center gap-12 lg:flex-row lg:justify-center lg:gap-16">
    <!-- Poster -->
    <div class="relative w-full max-w-[420px] shrink-0">
      <div class="absolute inset-0 -rotate-[4deg] rounded-[28px] bg-[#F5B903]"></div>
      <img
        src={gambarPoster}
        alt={altPoster}
        width="840"
        height="1048"
        loading="lazy"
        class="relative aspect-[420/524] w-full rounded-2xl border border-slate-200 object-cover shadow-[0_4px_6px_rgba(15,23,42,0.10)]"
      />
      <span class="absolute top-4 left-4 rounded-full bg-[#F5B903] px-3.5 py-1.5 text-xs leading-[17px] font-semibold text-slate-900 shadow-[0_1px_3px_rgba(15,23,42,0.10)]">
        {badge}
      </span>
    </div>
    <!-- Konten -->
    <div class="flex w-full flex-col items-start gap-7">
      <div class="flex w-full flex-col items-start gap-3">
        <p class="text-xs leading-[17px] font-semibold tracking-[1px] text-[#004AAD]">{overline}</p>
        <h2 class="text-h2 font-semibold text-slate-900">{judul}</h2>
        <p class="text-body-lg text-slate-600">{intro}</p>
      </div>
      <div class="flex w-full flex-col items-start gap-3.5">
        {sorotan.map((s) => (
          <div class="flex w-full items-start gap-3">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-[20px] bg-brand-50">
              <span class="block size-5" set:html={s.svg} />
            </span>
            <div class="flex min-w-0 flex-1 flex-col items-start gap-0.5">
              <p class="text-base leading-4 font-semibold text-slate-900">{s.judul}</p>
              <p class="text-body-sm tracking-[0.3px] text-slate-600">{s.deskripsi}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>