---
// Button — DS 6.2a (5 variant × 4 size) + state layer 3.4
interface Props {
  variant?: 'primary' | 'secondary' | 'outline' | 'text';
  size?: 'large' | 'default' | 'small' | 'xsmall';
  href?: string;
  type?: 'button' | 'submit';
  disabled?: boolean;
  class?: string;
}

const {
  variant = 'primary',
  size = 'default',
  href,
  type = 'button',
  disabled = false,
  class: className = '',
} = Astro.props;

const sizeClass = {
  large: 'h-14 px-8 text-base leading-4',      // 56px, teks 16/16
  default: 'h-12 px-6 text-base leading-4',    // 48px, teks 16/16
  small: 'h-10 px-4 text-sm leading-[21px]',   // 40px, teks 14/21 (Button SM)
  xsmall: 'h-8 px-3 text-xs leading-[17px]',   // 32px, teks 12/17 (Button XS)
}[size];

const variantClass = {
  primary: 'bg-brand-500 text-[#FAFAFA] hover:bg-brand-600',
  secondary: 'bg-orange-500 text-slate-900',
  outline: 'border border-brand-500 text-brand-500',
  text: 'text-brand-500',
}[variant];

// Overlay state (hover 8% / pressed 10%) hanya untuk variant yang TIDAK ganti bg
const needsOverlay = variant !== 'primary' && !disabled;

const Tag = href ? 'a' : 'button';
---

<Tag
  href={href}
  type={href ? undefined : type}
  disabled={href ? undefined : disabled}
  class:list={[
    'relative inline-flex items-center justify-center gap-2 rounded-full',
    'font-heading font-semibold transition-colors duration-150 ease-standard',
    'focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-brand-500 focus-visible:ring-offset-2',
    sizeClass,
    variantClass,
    needsOverlay && 'state-overlay overflow-hidden',
    disabled && 'cursor-not-allowed bg-slate-100 text-slate-400',
    className,
  ]}
>
  <span class="relative z-10"><slot /></span>
</Tag>

<style>
  /* State layer DS 3.4 — overlay slate-900: hover 8%, pressed 10% */
  .state-overlay::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: rgb(15 23 42 / 0);
    transition: background-color 150ms cubic-bezier(0.4, 0, 0.2, 1);
  }
  .state-overlay:hover::after {
    background: rgb(15 23 42 / 0.08);
  }
  .state-overlay:active::after {
    background: rgb(15 23 42 / 0.1);
  }
</style>