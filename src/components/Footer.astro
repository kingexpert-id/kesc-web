---
// Footer — 1:1 DS 6.11
const menuLinks = [
  { label: 'Program kami', href: '#', utama: true },
  { label: 'KESC', href: '/kesc', utama: false },
  { label: 'KEYSI', href: '/keysi', utama: false },
  { label: 'Jadwal', href: '/jadwal', utama: true },
  { label: 'Pengumuman', href: '/pengumuman', utama: true },
  { label: 'FAQ', href: '/faq', utama: true },
];

const kontak = [
  { ikon: 'wa', label: 'Mitra King Expert : 0831-3874-2348', href: 'tel:+6283138742348' },
  { ikon: 'wa', label: 'Admin King Expert : 0851-8321-3414', href: 'https://wa.me/6285183213414' },
  { ikon: 'mail', label: 'contact@kingexpert.id', href: 'mailto:contact@kingexpert.id' },
  { ikon: 'mail', label: 'kingexpert.sc@gmail.com', href: 'mailto:kingexpert.sc@gmail.com' },
];

const sosial = [
  { label: 'Instagram', href: 'https://www.instagram.com/kesc.id' },
  { label: 'Website', href: 'https://kingexpert.id' },
  { label: 'TikTok', href: '#' },
  { label: 'Facebook', href: '#' },
];

const labelOverline = 'font-heading text-xs font-semibold uppercase leading-[17px] tracking-[1px] text-white/60';
const linkMenuUtama = 'w-fit font-heading text-sm font-semibold leading-[21px] text-white transition-colors hover:text-white/70';
const linkMenuSub = 'w-fit pl-4 font-sans text-sm leading-[21px] text-white/80 transition-colors hover:text-white';
const teksBodySm = 'font-sans text-sm leading-[21px] text-white/80';
---

<footer class="bg-campaign-navy text-white">
  <div class="mx-auto grid max-w-[1240px] gap-10 px-4 py-12 md:grid-cols-2 md:px-8 lg:grid-cols-[1.5fr_1fr_1.3fr_1fr] lg:py-14">
    <!-- Brand -->
    <div class="flex flex-col items-start gap-4">
      <a href="/" class="flex items-center gap-3">
        <img src="/images/logo-kesc.png" alt="Logo King Expert Science Competition" width="64" height="64" class="h-10 w-10" />
        <span class="flex flex-col">
          <span class="font-heading text-base font-semibold leading-[21px] text-white">King Expert</span>
          <span class="font-sans text-xs leading-[17px] text-white/70">Science Competition</span>
        </span>
      </a>
      <p class="font-heading text-sm font-semibold leading-[21px] text-white">PT Harapan Eksper Edukasi Indonesia</p>
      <p class:list={[teksBodySm, 'max-w-xs']}>
        Gedung AD Premier Office Park Lantai 9, Jl. TB Simatupang No.5, RT 05 RW 07,
        Kelurahan Ragunan, Kecamatan Pasar Minggu, Kota Jakarta Selatan, DKI Jakarta 12550
      </p>
    </div>

    <!-- Menu -->
    <nav class="flex flex-col gap-3" aria-label="Menu footer">
      <span class:list={[labelOverline, 'mb-1']}>Menu</span>
      {menuLinks.map((l) => (
        <a href={l.href} class={l.utama ? linkMenuUtama : linkMenuSub}>{l.label}</a>
      ))}
    </nav>

    <!-- Kontak -->
    <div class="flex flex-col gap-4">
      <span class:list={[labelOverline, 'mb-1']}>Kontak</span>
      {kontak.map((k) => (
        <a href={k.href} class="flex items-center gap-3 transition-colors hover:text-white/70">
          {k.ikon === 'wa' ? (
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.88-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.347-.347.52-.52.174-.174.232-.297.347-.495.115-.198.058-.372-.03-.521-.087-.148-.66-1.59-.905-2.178-.24-.579-.487-.501-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z"/>
        </svg>
        ) : (
        <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
        )}
          <span class:list={[teksBodySm, 'font-semibold text-white']}>{k.label}</span>
        </a>
      ))}
    </div>

    <!-- Temukan Kami -->
    <div class="flex flex-col items-start gap-4">
      <span class:list={[labelOverline, 'mb-1']}>Temukan Kami</span>
      <div class="flex gap-3">
        {sosial.map((s) => (
          <a
            href={s.href}
            aria-label={s.label}
            class="flex h-10 w-10 items-center justify-center rounded-lg bg-white/[0.12] transition-colors hover:bg-white/[0.2]"
          >
            <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
              {s.label === 'Instagram' && <path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.2 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.2 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.2-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.2-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2Zm0 3.2a6.6 6.6 0 1 0 0 13.2 6.6 6.6 0 0 0 0-13.2Zm0 10.9a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6Zm6.9-11.2a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0Z"/>}
              {s.label === 'Website' && <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Zm7.9 9h-3.4a15.7 15.7 0 0 0-1.2-5.6A8 8 0 0 1 19.9 11ZM12 4c.9 1.2 1.9 3.5 2.2 7H9.8c.3-3.5 1.3-5.8 2.2-7ZM4.1 13h3.4c.1 2.1.5 4 1.2 5.6A8 8 0 0 1 4.1 13Zm4.7-2H4.1a8 8 0 0 1 4.6-5.6A15.7 15.7 0 0 0 7.5 11h1.3Zm.5 2h5.4c-.3 3.5-1.3 5.8-2.2 7-.9-1.2-1.9-3.5-2.2-7h-1Zm6.9 0h3.7a8 8 0 0 1-4.6 5.6c.7-1.6 1-3.5 1.2-5.6h-.3Z"/>}
              {s.label === 'TikTok' && <path d="M16.6 3c.4 2.1 1.7 3.4 3.9 3.6v2.8c-1.4 0-2.7-.4-3.9-1.2v5.7a6 6 0 1 1-6-6c.3 0 .7 0 1 .1v2.9a3.1 3.1 0 1 0 2.2 3V3h2.8Z"/>}
              {s.label === 'Facebook' && <path d="M13.5 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.2-1.4 1.4-1.4h1.5V5.3c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H8v2.8h2.5V21h3Z"/>}
            </svg>
          </a>
        ))}
      </div>
      <a href="https://www.instagram.com/kesc.id" class={linkMenuUtama}>instagram.com/kesc.id</a>
      <a href="https://kingexpert.id" class={linkMenuUtama}>kingexpert.id</a>
    </div>
  </div>

  <!-- Copyright -->
  <div class="border-t border-white/10">
    <p class="mx-auto max-w-[1240px] px-4 py-6 text-center font-sans text-xs font-medium leading-[17px] text-white/60 md:px-8">
      © 2027 King Expert. All rights reserved PT Harapan Eksper Edukasi Indonesia.
    </p>
  </div>
</footer>