---
import CardTopik from './CardTopik.astro';

const ikon = (path: string) =>
  `<svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">${path}</svg>`;
const topik = [
  { nomor: '01', judul: 'Pendidikan dan Pengembangan SDM', deskripsi: 'Inovasi pembelajaran, literasi digital, pemerataan pendidikan, dan keterampilan masa depan.', svg: ikon('<path d="M12 20C16 17 21 18 21 18V3C21 3 16 2 12 5C8 2 3 3 3 3V18C3 18 8 17 12 20ZM12 5V20" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '02', judul: 'Teknologi dan Transformasi Digital', deskripsi: 'AI, big data, cybersecurity, smart society, dan digitalisasi pelayanan publik.', svg: ikon('<path d="M8 6H16C17.1046 6 18 6.89543 18 8V16C18 17.1046 17.1046 18 16 18H8C6.89543 18 6 17.1046 6 16V8C6 6.89543 6.89543 6 8 6Z" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/><path d="M10 9H14C14.5523 9 15 9.44772 15 10V14C15 14.5523 14.5523 15 14 15H10C9.44772 15 9 14.5523 9 14V10C9 9.44772 9.44772 9 10 9Z" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/><path d="M9 3V6M15 3V6M9 18V21M15 18V21M3 9H6M3 15H6M18 9H21M18 15H21" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '03', judul: 'Lingkungan dan Keberlanjutan', deskripsi: 'Perubahan iklim, ekonomi sirkular, pengelolaan sampah, konservasi, dan gaya hidup berkelanjutan.', svg: ikon('<path d="M6.75736 17.2426C5.63214 16.1174 5 14.5913 5 13C5 6 11 3 20 3C20 12 18 19 11 19C9.4087 19 7.88258 18.3679 6.75736 17.2426ZM6.75736 17.2426L3 21M6.75736 17.2426L15 9" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '04', judul: 'Energi dan Ketahanan Nasional', deskripsi: 'Energi terbarukan, transisi energi, ketahanan energi, dan teknologi hijau.', svg: ikon('<path d="M13 2L4 14H11L10 22L20 9H13V2Z" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '05', judul: 'Ekonomi dan Kewirausahaan', deskripsi: 'Ekonomi kreatif, UMKM, fintech, kewirausahaan sosial, dan ekonomi digital.', svg: ikon('<path d="M4 3V20H21M8 15L12 10L16 12L21 5M21 10V5H16" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '06', judul: 'Ketahanan Pangan dan Pertanian Berkelanjutan', deskripsi: 'Ketahanan pangan, smart farming, diversifikasi pangan, dan inovasi pertanian.', svg: ikon('<path d="M12 21V15M12 21H6M12 21H18M12 15V12M12 15C4 16 2 12 3 6C7.90996 6 10.8519 7.47598 11.8259 10.4279M12 15C12.1821 13.9074 12.2316 12.9142 12.1484 12.0205M12 12C11.9085 11.4508 11.8505 10.9268 11.8259 10.4279M12 12C12.0497 12.0071 12.0991 12.0139 12.1484 12.0205M11.8259 10.4279C11.9877 10.9181 12.0952 11.449 12.1484 12.0205M11.8259 10.4279C11.5827 5.47598 14.6407 3 21 3C21.9929 8.95744 19.0424 12.9431 12.1484 12.0205" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '07', judul: 'Kesehatan dan Kesejahteraan Masyarakat', deskripsi: 'Teknologi kesehatan, kesehatan preventif, gaya hidup sehat, dan peningkatan kualitas hidup.', svg: ikon('<path d="M3 11H8L10 8L13 14L15 11H21M20.8 4.6C20.2889 4.086 19.6812 3.67811 19.0119 3.39977C18.3426 3.12143 17.6249 2.97814 16.9 2.97814C16.1751 2.97814 15.4574 3.12143 14.7881 3.39977C14.1188 3.67811 13.5111 4.086 13 4.6L12 5.7L10.9 4.6C9.86565 3.56566 8.46278 2.98457 7 2.98457C5.53722 2.98457 4.13434 3.56566 3.1 4.6C2.06566 5.63434 1.48457 7.03722 1.48457 8.5C1.48457 9.96278 2.06566 11.3657 3.1 12.4L12 21L20.8 12.4C21.314 11.8889 21.7219 11.2812 22.0002 10.6119C22.2786 9.94259 22.4219 9.22487 22.4219 8.5C22.4219 7.77513 22.2786 7.05741 22.0002 6.3881C21.7219 5.7188 21.314 5.11112 20.8 4.6Z" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '08', judul: 'Sosial, Budaya, dan Humaniora', deskripsi: 'Riset & inovasi teknologi untuk pelestarian budaya (digitalisasi warisan budaya, revitalisasi bahasa daerah) dan penguatan inklusivitas sosial (teknologi asistif bagi disabilitas, pemberdayaan komunitas rentan), di tengah dinamika perubahan sosial dan keberagaman identitas generasi muda.', svg: ikon('<path d="M12 7C12 8.65685 10.6569 10 9 10C7.34315 10 6 8.65685 6 7C6 5.34315 7.34315 4 9 4C10.6569 4 12 5.34315 12 7Z" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/><path d="M3 21V18C3 16.4087 3.63214 14.8826 4.75736 13.7574C5.88258 12.6321 7.4087 12 9 12C10.5913 12 12.1174 12.6321 13.2426 13.7574C14.3679 14.8826 15 16.4087 15 18V21M16 4C16.7956 4 17.5587 4.31607 18.1213 4.87868C18.6839 5.44129 19 6.20435 19 7C19 7.79565 18.6839 8.55871 18.1213 9.12132C17.5587 9.68393 16.7956 10 16 10M19 21V18C18.9663 16.9803 18.6732 15.986 18.1482 15.1111C17.6233 14.2362 16.8839 13.5096 16 13" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
  { nomor: '09', judul: 'Kota dan Infrastruktur Masa Depan', deskripsi: 'Smart city, transportasi berkelanjutan, perumahan, mitigasi bencana, dan tata ruang.', svg: ikon('<path d="M3 21V9H10V21M3 21H1M3 21H10M10 21H21M10 6V3H21V21M21 21H23M6 12V13M6 16V17M14 6V7M18 6V7M14 10V11M18 10V11M14 14V15M18 14V15" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" stroke="#004AAD"/>') },
];
---

<section class="bg-[#F5F5F5] px-6 py-16 md:px-14 lg:px-[72px] min-[1440px]:px-[100px]">
  <div class="mx-auto flex max-w-[1240px] flex-col items-center gap-8">
    <h2 class="text-center text-h2 font-semibold text-slate-900">
      Topik King Expert Young Science Ideation 2027
    </h2>
    <div class="grid w-full grid-cols-1 gap-6 md:grid-cols-2 lg:grid-cols-3 lg:gap-[30px]">
      {topik.map((t) => <CardTopik {...t} />)}
    </div>
  </div>
</section>